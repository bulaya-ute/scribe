# Scribe — stack environment (PRIN-3 f).
# Copy to .env (never committed) or paste these values into Portainer's
# stack environment section. Only the version is required; everything else
# has a working default.

# ── Release ────────────────────────────────────────────────────────────────
# Image tag to run: ghcr.io/bulaya-ute/scribe:${SCRIBE_VERSION}
# Set to a released tag (v1.0.0, v1.1.0 …), never a branch name.
SCRIBE_VERSION=v1.0.0

# ── Edge ───────────────────────────────────────────────────────────────────
# Shared reverse-proxy network that Caddy is attached to.
PROXY_NETWORK=proxy

# ── Behaviour (defaults are production values) ─────────────────────────────
# No ports are published: Caddy reaches the container as scribe:80.
# No volumes: the app is stateless by design (DEC-no-persistence).
